# ==========================================
# 🌐 APPLICATION
# ==========================================
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ==========================================
# 🗄️ DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=db_admin
DB_PASSWORD=change_this_to_a_strong_password

# ==========================================
# 🔐 AUTH & SECRETS
# ==========================================
JWT_SECRET=replace_with_a_long_random_string
SESSION_SECRET=another_random_secret_key
API_KEY=your_third_party_api_key

# ==========================================
# 📧 EMAIL / SMTP
# ==========================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=smtp_password_or_app_token
SMTP_TLS=true

# ==========================================
# ⚙️ FEATURE FLAGS / CUSTOM CONFIG
# ==========================================
ENABLE_CACHE=true
CACHE_TTL=3600
MAX_UPLOAD_SIZE_MB=10
